{
  "name": "@mizpah-pulse/ws",
  "version": "0.0.1",
  "private": true,
  "description": "MizpahPulse WebSocket server for real-time event broadcasting",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && tsx src/index.ts",
    "build": "node init && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mizpah-pulse/types": "*",
    "cors": "^2.8.5",
    "ioredis": "^5.4.1",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
