# ──────────────────────────────────────────────
# MizPahPulse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://mizpah:mizpah_dev@localhost:5432/mizpah_pulse

# ── Redis ─────────────────────────────────────
# Redis connection URL (BullMQ queue + Pub/Sub)
REDIS_URL=redis://localhost:6379

# ── Stellar Network ───────────────────────────
# Network to connect to: TESTNET | PUBLIC | FUTURENET | SANDBOX
STELLAR_NETWORK=TESTNET

# Horizon API URL (optional — auto-derived from STELLAR_NETWORK)
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL (optional — auto-derived from STELLAR_NETWORK)
# STELLAR_SOROBAN_RPC_URL=https://soroban-rpc.testnet.stellar.org

# ── Pulse Smart Contract ──────────────────────
# Deployed PulseContract ID on Stellar Testnet
# Set after running: npx tsx scripts/deploy-contract.ts
NEXT_PUBLIC_PULSE_CONTRACT_ID=CC4HXCVIOPUOS2UJFLTM6WP2ESNSWM4BGJ26XR4SRRVB74TOZMC7EE2C

# ── WebSocket Server ──────────────────────────
# URL of the WebSocket server (for the frontend client)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# CORS origin for the WebSocket server
CORS_ORIGIN=http://localhost:3000

# WebSocket server port (default: 3001)
WS_PORT=3001

# ── Contract Deployment ───────────────────────
# Secret key of a funded Stellar Testnet account
# Generate one: https://laboratory.stellar.org/#account-creator?network=test
DEPLOYER_SECRET=S...

# ── Security ──────────────────────────────────
# Secret for signing webhook payloads
WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Secret for signing JWTs
JWT_SECRET=dev-jwt-secret-change-in-production

# Secret for API key generation
API_KEY_SECRET=dev-api-key-secret-change-in-production

# ── App (Next.js) ─────────────────────────────
# Node environment
NODE_ENV=development

# Public Stellar network for the frontend
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Prisma log level
PRISMA_LOG_LEVEL=info

# ── Event Retention ──────────────────────────
# Number of days to keep events in the database. When set, the ingester
# prunes events older than this on startup and every 6 hours. Unset, empty,
# or 0 disables pruning (default).
# EVENT_RETENTION_DAYS=90
