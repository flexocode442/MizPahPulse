{
  "name": "@mizpah-pulse/database",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma database schema and client for MizpahPulse",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node init && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@mizpah-pulse/types": "*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
